<?xml version="1.0" encoding="UTF-8"?>
<rng:grammar
  xmlns:rng="http://relaxng.org/ns/structure/1.0"
  xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"
  xmlns="http://www.w3.org/1999/xhtml"
  xmlns:h="http://www.w3.org/1999/xhtml"
  datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"
  ns="http://www.tei-c.org/ns/1.0"
  xml:lang="fr">
  
  <rng:define name="refsDecl">
    <rng:element name="refsDecl">
      <a:documentation>
        <p>L'élément <code>refsDecl</code> précise la manière dont les références ont été construites pour ce texte.</p>
      </a:documentation>
      <rng:zeroOrMore>
        <rng:ref name="citeStructure"/>
      </rng:zeroOrMore>
    </rng:element>
  </rng:define>
  
  <rng:define name="citeStructure">
    <a:documentation>
      <p>L'élement <code>citeStructure</code> déclare la structure et la méthode pour citer le document.</p>
      <p>Cet élément permet ensuite à l'API DTS de reconstruire automatiquement la structure éditoriale et les passages dans le document.</p>
    </a:documentation>
    <rng:element name="citeStructure">
      <rng:attribute name="match"/>
      <rng:attribute name="use"/>
      <rng:optional>
        <rng:attribute name="unit"/>
      </rng:optional>
      <rng:optional>
        <rng:attribute name="delim"/>
      </rng:optional>
      <rng:zeroOrMore>
        <rng:ref name="citeData"/>
      </rng:zeroOrMore>
      <rng:zeroOrMore>
        <rng:ref name="citeStructure"/>
      </rng:zeroOrMore>
    </rng:element>
  </rng:define>
  
  <rng:define name="citeData">
    <a:documentation>
      <p>L'élement <code>citeData</code> permet de déclarer des métadonnées pour décrire des passages, et d’indiquer le XPath pour retrouver les valeurs associées à ces métadonnées.</p>
      <p>Cet élément permet ensuite à l'API DTS d'indiquer les métadonnées pour décrire les passages.</p>
    </a:documentation>
    <rng:element name="citeData">
      <rng:attribute name="property"/>
      <rng:attribute name="use"/>
    </rng:element>
  </rng:define>
  
  <!-- insérer documentation sur <choice> dès que cela aura été validé. De même choice pourra être utilisé pour combiner add et del. -->
  
  <rng:start combine="choice">
    <a:documentation xmlns="http://www.w3.org/1999/xhtml">Nécessaire à la validation du schéma</a:documentation>
    <rng:ref name="refsDecl"/>
  </rng:start>  
  
</rng:grammar>
