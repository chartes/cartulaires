<dots:metadataMap xmlns:dots="https://github.com/chartes/dots/" xmlns:dts="https://dtsapi.org/context/v1.0.json" xmlns:dct="http://purl.org/dc/terms/" xmlns:schema="https://schema.org/" xmlns:html="http://www.w3.org/1999/xhtml">
  <dots:mapping>
    <dct:title scope="collection" source="./collection.csv" value="title"/>
    <dct:creator scope="collection" source="./collection.csv" value="author"/>
    <dct:publisher scope="collection" source="./collection.csv" value="publisher"/>
    <dct:issued scope="collection" source="./collection.csv" value="date"/>
    <dct:description scope="collection" source="./collection.csv" value="description"/>
    <schema:name scope="collection" source="./collection.csv" value="title"/>
    <schema:author scope="collection" source="./collection.csv" type="object">
      <dots:objectProperty name="@type" resourceId="all">schema:Person</dots:objectProperty>
      <dots:objectProperty name="@id" value="author_idref_ppn"/>
      <dots:objectProperty name="name" value="author"/>
      <dots:objectProperty name="sameAs" value="author_bnf_ark"/>
    </schema:author>
    <schema:publisher scope="collection" source="./collection.csv" type="object">
      <dots:objectProperty name="@type" resourceId="all">schema:Organization</dots:objectProperty>
      <dots:objectProperty name="@id" value="publisher_link"/>
      <dots:objectProperty name="name" value="publisher"/>
    </schema:publisher>
    <schema:datePublished scope="collection" source="./collection.csv" value="date"/>
    <schema:description scope="collection" source="./collection.csv" value="description"/>
    <dct:title scope="document" xpath="/TEI/teiHeader/fileDesc/titleStmt/title[1]"/>
    <dct:creator scope="document" xpath="/TEI/teiHeader/fileDesc/titleStmt/author"/>
    <dct:created scope="document" xpath="/TEI/teiHeader/profileDesc/creation/date[not(@type)]"/>
    <dct:isVersionOf scope="document" xpath="/TEI/teiHeader/fileDesc/titleStmt/title/tokenize(@ref)" type="array"/>
    <dct:language scope="document" xpath="/TEI/teiHeader/profileDesc/langUsage/language/tokenize(@ident)"/>
    <dct:contributor scope="document" xpath="/TEI/teiHeader/fileDesc/titleStmt/principal | /TEI/teiHeader/fileDesc/titleStmt/editor"/>
    <dct:source scope="document" xpath="/TEI/teiHeader/fileDesc/sourceDesc/bibl"/>
    <dct:publisher scope="document" xpath="/TEI/teiHeader/fileDesc/publicationStmt/publisher"/>
    <dct:issued scope="document" xpath="/TEI/teiHeader/fileDesc/publicationStmt/date"/>
    <dct:bibliographicalCitation scope="document" xpath="if (/TEI/teiHeader/fileDesc/titleStmt/editor or /TEI/teiHeader/fileDesc/titleStmt/principal) then concat( string-join(/TEI/teiHeader/fileDesc/titleStmt/node()[name() = 'editor' or name() = 'principal'], ', '), ' (éd.), ', /TEI/teiHeader/fileDesc/titleStmt/title[1], ', ', /TEI/teiHeader/fileDesc/publicationStmt/publisher, ', ', /TEI/teiHeader/fileDesc/publicationStmt/date, '. [En ligne : https://dev.chartes.psl.eu/elec/cjc/document/', /TEI/@xml:id, ']')"/>
    <dct:coverage scope="document" xpath="/TEI/teiHeader/profileDesc/creation/date[@type='coverage']"/>
    <dct:description scope="document" xpath="/TEI/teiHeader/encodingDesc/projectDesc/p"/>
    <dct:license scope="document" xpath="/TEI/teiHeader/fileDesc/publicationStmt/availability/licence/@target"/>
    <dct:rights scope="document" xpath="/TEI/teiHeader/fileDesc/publicationStmt/availability/licence"/>
    <dct:identifier scope="document" xpath="/TEI/teiHeader/fileDesc/publicationStmt/idno"/>
    <schema:type scope="document" resourceId="all">Book</schema:type>
    <schema:name scope="document" xpath="/TEI/teiHeader/fileDesc/titleStmt/title[1]"/>
    <schema:author scope="document" xpath="/TEI/teiHeader/fileDesc/titleStmt/author[@ref]" type="object">
      <dots:objectProperty name="@type" resourceId="all">schema:Person</dots:objectProperty>
      <dots:objectProperty name="@id" xpath="let $refs := tokenize(@ref) return $refs[1]"/>
      <dots:objectProperty name="name" xpath="."/>
      <dots:objectProperty name="sameAs" xpath="subsequence(tokenize(@ref), 2)"/>
    </schema:author>
    <schema:dateCreated scope="document" xpath="/TEI/teiHeader/profileDesc/creation/date[not(@type)]"/>
    <schema:exampleOfWork scope="document" xpath="/TEI/teiHeader/fileDesc/titleStmt/title[@ref]" type="object">
      <dots:objectProperty name="@type" resourceId="all">schema:CreativeWork</dots:objectProperty>
      <dots:objectProperty name="@id" xpath="let $refs := tokenize(@ref) return $refs[1]"/>
      <dots:objectProperty name="name" xpath="."/>
      <dots:objectProperty name="sameAs" xpath="subsequence(tokenize(@ref), 2)"/>
    </schema:exampleOfWork>
    <schema:inLanguage scope="document" xpath="/TEI/teiHeader/profileDesc/langUsage/language/tokenize(@ident)"/>
    <schema:editor scope="document" xpath="/TEI/teiHeader/fileDesc/titleStmt/editor[@ref] | /TEI/teiHeader/fileDesc/titleStmt/principal[@ref]" type="object">
      <dots:objectProperty name="@type" resourceId="all">schema:Person</dots:objectProperty>
      <dots:objectProperty name="@id" xpath="let $refs := tokenize(@ref) return $refs[1]"/>
      <dots:objectProperty name="name" xpath="."/>
      <dots:objectProperty name="sameAs" xpath="subsequence(tokenize(@ref), 2)"/>
    </schema:editor>
    <schema:isBasedOn scope="document" xpath="/TEI/teiHeader/fileDesc/sourceDesc/bibl[@source]" type="object">
      <dots:objectProperty name="@type" resourceId="all">schema:CreativeWork</dots:objectProperty>
      <dots:objectProperty name="@id" xpath="let $sources := tokenize(@source) return $sources[1]"/>
      <dots:objectProperty name="name" xpath="."/>
      <dots:objectProperty name="sameAs" xpath="subsequence(tokenize(@source), 2)"/>
    </schema:isBasedOn>
    <schema:publisher scope="document" xpath="/TEI/teiHeader/fileDesc/publicationStmt/publisher/@ref" type="object">
      <dots:objectProperty name="@type" resourceId="all">schema:Organization</dots:objectProperty>
      <dots:objectProperty name="@id" xpath="."/>
      <dots:objectProperty name="name" xpath="./parent::publisher"/>
    </schema:publisher>
    <schema:datePublished scope="document" xpath="/TEI/teiHeader/fileDesc/publicationStmt/date"/>
    <schema:creditText scope="document" xpath="if (/TEI/teiHeader/fileDesc/titleStmt/editor or /TEI/teiHeader/fileDesc/titleStmt/principal) then concat( string-join(/TEI/teiHeader/fileDesc/titleStmt/node()[name() = 'editor' or name() = 'principal'], ', '), ' (éd.), ', /TEI/teiHeader/fileDesc/titleStmt/title[1], ', ', /TEI/teiHeader/fileDesc/publicationStmt/publisher, ', ', /TEI/teiHeader/fileDesc/publicationStmt/date, '. [En ligne : https://dev.chartes.psl.eu/elec/cjc/document/', /TEI/@xml:id, ']')"/>
    <schema:temporalCoverage scope="document" xpath="/TEI/teiHeader/profileDesc/creation/date[@type='coverage']"/>
    <schema:description scope="document" xpath="/TEI/teiHeader/encodingDesc/projectDesc/p"/>
    <schema:license scope="document" xpath="/TEI/teiHeader/fileDesc/publicationStmt/availability/licence/@target"/>
    <schema:encoding scope="document" xpath="/TEI/@xml:id" type="object">
      <dots:objectProperty name="@type" resourceId="all">schema:MediaObject</dots:objectProperty>
      <dots:objectProperty name="encodingFormat" resourceId="all">application/tei+xml</dots:objectProperty>
      <dots:objectProperty name="contentUrl" xpath="concat('https://dev.chartes.psl.eu/dots/api/dts/document?resource=', .)"/>
    </schema:encoding>
    <schema:encoding scope="document" xpath="/TEI/@xml:id" type="object">
      <dots:objectProperty name="@type" resourceId="all">schema:MediaObject</dots:objectProperty>
      <dots:objectProperty name="encodingFormat" resourceId="all">text/html</dots:objectProperty>
      <dots:objectProperty name="contentUrl" xpath="concat('https://dev.chartes.psl.eu/dots/api/dts/document?resource=', ., codepoints-to-string(38), 'mediaType=html')"/>
    </schema:encoding>
    <schema:associatedMedia scope="document" xpath="/TEI/teiHeader/fileDesc/sourceDesc/@facs" type="object">
      <dots:objectProperty name="@type" resourceId="all">schema:MediaObject</dots:objectProperty>
      <dots:objectProperty name="encodingFormat" resourceId="all">application/ld+json;profile=http://iiif.io/api/presentation/3/context.json/html</dots:objectProperty>
      <dots:objectProperty name="contentUrl" xpath="."/>
    </schema:associatedMedia>
    <download xmlns="http://www.tei-c.org/ns/1.0" scope="document" xpath="let $id := /TEI/@xml:id return concat('api/dts/document?resource=', $id)" prefix="https://dev.chartes.psl.eu/dots/"/>
    <dots:resourceIIIFManifest scope="document" xpath="//sourceDesc/@facs"/>
    <dots:shortTitle scope="document" xpath="/TEI/teiHeader/fileDesc/titleStmt/title[@type='short']"/>
  </dots:mapping>
</dots:metadataMap>